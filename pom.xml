<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>id.alwination</groupId>
    <artifactId>ModernSlimefunPet</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>ModernSlimefunPet</name>
    <description>Slimefun-server pet plugin: pets, evolution, stats and AFK XP for Paper 26.3.</description>

    <properties>
        <mckit.nullaway.packages>id.alwination.slimefunpet</mckit.nullaway.packages>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>6.0.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <archunit.version>1.5.1</archunit.version>
        <jspecify.version>1.0.1</jspecify.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <relocations>
                        <!-- Other plugins on the server shade MDLib too; relocate to avoid clashes. -->
                        <relocation>
                            <pattern>redempt.crunch</pattern>
                            <shadedPattern>id.alwination.slimefunpet.libs.crunch</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>com.zaxxer.hikari</pattern>
                            <shadedPattern>id.alwination.slimefunpet.libs.hikari</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>com.muhammaddaffa.mdlib</pattern>
                            <shadedPattern>id.alwination.slimefunpet.libs.mdlib</shadedPattern>
                        </relocation>
                    </relocations>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                                <exclude>module-info.class</exclude>
                            </excludes>
                        </filter>
                    </filters>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <!-- plugin.yml needs ${project.version}; every other resource is copied as-is so new
                 files (pieces, menus) are never left out and never get ${...} replaced. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>blocksmith-releases</id>
            <url>https://repo.blocksmith.studio/releases</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>codemc-releases</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>26.3.build.249-stable</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>2.14.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.muhammaddaffa</groupId>
            <artifactId>mdlib-spigot</artifactId>
            <version>3.0.1</version>
        </dependency>
        <!-- Only because MDLib's Vault economy hook is compiled against it; Vault is not required. -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7.1</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>6.3.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- The server's own Slimefun fork, for its events only (provided by the server, softdepend).
             Not on any repository: install the fork's jar into the local Maven repo first, see
             MILESTONES.md "Building". -->
        <dependency>
            <groupId>io.github.thebusybiscuit</groupId>
            <artifactId>slimefun5-ae</artifactId>
            <version>5.0.0-UNOFFICIAL</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Crunch: the level-cost and exp-per-food formulas in pets.yml (shaded and relocated). -->
        <dependency>
            <groupId>com.github.Redempt</groupId>
            <artifactId>Crunch</artifactId>
            <version>2.0</version>
        </dependency>
        <!-- JDBC drivers: Paper ships both at runtime, so they are provided here. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.50.3.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.mckit</groupId>
            <artifactId>mc-archrules</artifactId>
            <version>0.1.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <profiles>
        <!-- mckit:profile:start (managed by mc-plugin-kit; re-run mckit_apply.py to update) -->
        <profile>
            <id>mckit-lint</id>
            <activation>
                <property><name>!mckit.skip</name></property>
            </activation>
            <properties>
                <mckit.dir>${maven.multiModuleProjectDirectory}/config/mckit</mckit.dir>
                <mckit.errorprone.version>2.50.0</mckit.errorprone.version>
                <mckit.nullaway.version>0.14.2</mckit.nullaway.version>
                <!-- ERROR for new code; WARN while ratcheting a legacy codebase. -->
                <mckit.nullaway.severity>ERROR</mckit.nullaway.severity>
                <!-- Classes ported as they were from ModernMineGens, which predate NullAway. They are
                     treated as unannotated (not checked) until each is fixed and taken off this list
                     (MILESTONES.md, "NullAway ratchet"). Everything else is checked at ERROR. -->
                <mckit.nullaway.unannotated>id.alwination.slimefunpet.pets.AutoFeed,id.alwination.slimefunpet.pets.Pet,id.alwination.slimefunpet.pets.PetPlayer,id.alwination.slimefunpet.pets.PetSettings,id.alwination.slimefunpet.pets.evolution.EvolutionRequirement,id.alwination.slimefunpet.pets.evolution.EvolutionRequirements,id.alwination.slimefunpet.pets.evolution.ItemEvolutionRequirement,id.alwination.slimefunpet.pets.evolution.MoneyEvolutionRequirement,id.alwination.slimefunpet.pets.gui.PetAutoFeedInventory,id.alwination.slimefunpet.pets.gui.PetEvolutionInventory,id.alwination.slimefunpet.pets.gui.PetInventory,id.alwination.slimefunpet.pets.gui.PetOptionsInventory,id.alwination.slimefunpet.pets.gui.PetRerollInventory,id.alwination.slimefunpet.pets.gui.PetSkinInventory,id.alwination.slimefunpet.pets.gui.PetStatLockInventory,id.alwination.slimefunpet.pets.items.PetItem,id.alwination.slimefunpet.pets.items.PetItemRegistry,id.alwination.slimefunpet.pets.items.PetItemType,id.alwination.slimefunpet.pets.items.RerollOutcome,id.alwination.slimefunpet.pets.listeners.PetItemListener,id.alwination.slimefunpet.pets.managers.PetManager,id.alwination.slimefunpet.pets.managers.PetService,id.alwination.slimefunpet.pets.stats.PetStat,id.alwination.slimefunpet.pets.stats.PetStatKind,id.alwination.slimefunpet.pets.stats.PetStatRegistry,id.alwination.slimefunpet.pets.stats.PetStatSerializer,id.alwination.slimefunpet.pets.stats.PetStatType,id.alwination.slimefunpet.pets.tasks.PetFoodTask,id.alwination.slimefunpet.utils.ColorUtil,id.alwination.slimefunpet.utils.PlayableSound,id.alwination.slimefunpet.utils.Utils</mckit.nullaway.unannotated>
                <!-- Empty default so @{argLine} resolves when JaCoCo etc. are absent. -->
                <argLine/>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>mckit-enforce</id>
                                <goals><goal>enforce</goal></goals>
                                <configuration>
                                    <rules>
                                        <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                                        <banDuplicatePomDependencyVersions/>
                                        <!-- The server provides these at runtime. Shading them causes
                                             LinkageError / duplicate-class failures on load. -->
                                        <bannedDependencies>
                                            <excludes>
                                                <exclude>io.papermc.paper:paper-api:*:*:compile</exclude>
                                                <exclude>io.papermc.paper:paper-api:*:*:runtime</exclude>
                                                <exclude>org.spigotmc:spigot-api:*:*:compile</exclude>
                                                <exclude>org.bukkit:bukkit:*:*:compile</exclude>
                                                <exclude>io.netty:*:*:*:compile</exclude>
                                                <exclude>com.mojang:brigadier:*:*:compile</exclude>
                                                <exclude>net.kyori:adventure-api:*:*:compile</exclude>
                                            </excludes>
                                            <searchTransitive>true</searchTransitive>
                                        </bannedDependencies>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>3.15.0</version>
                        <configuration>
                            <showWarnings>true</showWarnings>
                            <compilerArgs combine.children="append">
                                <arg>-Xlint:all,-processing,-serial</arg>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*/target/generated-.*/.* -Xep:NullAway:${mckit.nullaway.severity} -XepOpt:NullAway:AnnotatedPackages=${mckit.nullaway.packages} -XepOpt:NullAway:UnannotatedClasses=${mckit.nullaway.unannotated} -XepOpt:NullAway:JSpecifyMode=true</arg>
                                <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                            </compilerArgs>
                            <annotationProcessorPaths combine.children="append">
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${mckit.errorprone.version}</version>
                                </path>
                                <path>
                                    <groupId>com.uber.nullaway</groupId>
                                    <artifactId>nullaway</artifactId>
                                    <version>${mckit.nullaway.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-checkstyle-plugin</artifactId>
                        <version>3.6.0</version>
                        <dependencies>
                            <dependency>
                                <groupId>com.puppycrawl.tools</groupId>
                                <artifactId>checkstyle</artifactId>
                                <version>14.1.0</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <configLocation>${mckit.dir}/checkstyle.xml</configLocation>
                            <consoleOutput>true</consoleOutput>
                            <failOnViolation>true</failOnViolation>
                            <violationSeverity>error</violationSeverity>
                            <includeTestSourceDirectory>true</includeTestSourceDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>mckit-checkstyle</id>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-pmd-plugin</artifactId>
                        <version>3.28.0</version>
                        <dependencies>
                            <!-- The plugin bundles an older PMD; pin the current engine. -->
                            <dependency>
                                <groupId>net.sourceforge.pmd</groupId>
                                <artifactId>pmd-core</artifactId>
                                <version>7.28.0</version>
                            </dependency>
                            <dependency>
                                <groupId>net.sourceforge.pmd</groupId>
                                <artifactId>pmd-java</artifactId>
                                <version>7.28.0</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <rulesets><ruleset>${mckit.dir}/pmd-ruleset.xml</ruleset></rulesets>
                            <printFailingErrors>true</printFailingErrors>
                            <failOnViolation>true</failOnViolation>
                            <linkXRef>false</linkXRef>
                            <analysisCache>true</analysisCache>
                        </configuration>
                        <executions>
                            <execution>
                                <id>mckit-pmd</id>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.10.4.1</version>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Medium</threshold>
                            <excludeFilterFile>${mckit.dir}/spotbugs-exclude.xml</excludeFilterFile>
                            <plugins>
                                <plugin>
                                    <groupId>com.h3xstream.findsecbugs</groupId>
                                    <artifactId>findsecbugs-plugin</artifactId>
                                    <version>1.14.0</version>
                                </plugin>
                            </plugins>
                        </configuration>
                        <executions>
                            <execution>
                                <id>mckit-spotbugs</id>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.6.0</version>
                        <configuration>
                            <!-- Netty leak detector at max: leaks are only LOGGED as "LEAK:"; scripts/gate.py fails the gate on them. -->
                            <argLine>-Dio.netty.leakDetection.level=paranoid @{argLine}</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- mckit:profile:end -->
    </profiles>
</project>
